{
  "$defs": {
    "Actor": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "human",
            "agent"
          ],
          "title": "Kind",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "runtime": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Runtime"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "title": "Actor",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "actor": {
      "$ref": "#/$defs/Actor"
    },
    "commits": {
      "items": {
        "type": "string"
      },
      "title": "Commits",
      "type": "array"
    },
    "cost_usd": {
      "default": 0.0,
      "title": "Cost Usd",
      "type": "number"
    },
    "ended_at": {
      "title": "Ended At",
      "type": "string"
    },
    "hash": {
      "title": "Hash",
      "type": "string"
    },
    "inputs": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "file name -> sha256; 'head' -> commit",
      "title": "Inputs",
      "type": "object"
    },
    "note": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Note"
    },
    "on_behalf_of": {
      "title": "On Behalf Of",
      "type": "string"
    },
    "outputs": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "file name -> sha256",
      "title": "Outputs",
      "type": "object"
    },
    "prev_hash": {
      "title": "Prev Hash",
      "type": "string"
    },
    "role": {
      "enum": [
        "initiator",
        "planner",
        "plan_approval",
        "implementer",
        "reviewer",
        "human_change"
      ],
      "title": "Role",
      "type": "string"
    },
    "role_prompt_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Role Prompt Sha256"
    },
    "seq": {
      "minimum": 0,
      "title": "Seq",
      "type": "integer"
    },
    "started_at": {
      "title": "Started At",
      "type": "string"
    },
    "task": {
      "title": "Task",
      "type": "string"
    },
    "tokens_in": {
      "default": 0,
      "title": "Tokens In",
      "type": "integer"
    },
    "tokens_out": {
      "default": 0,
      "title": "Tokens Out",
      "type": "integer"
    }
  },
  "required": [
    "seq",
    "task",
    "role",
    "actor",
    "on_behalf_of",
    "started_at",
    "ended_at",
    "prev_hash",
    "hash"
  ],
  "title": "LedgerEntry",
  "type": "object"
}
